{
  "name": "@reactionview/dev-tools",
  "version": "0.4.0",
  "description": "Development tools for ReActionView with Herb integration",
  "type": "module",
  "license": "MIT",
  "main": "./dist/reactionview-dev-tools.umd.js",
  "module": "./dist/reactionview-dev-tools.esm.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "yarn clean && tsc --emitDeclarationOnly && rolldown -c",
    "dev": "rolldown -c -w",
    "clean": "rimraf dist && rimraf ../../../app/assets/"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/reactionview-dev-tools.esm.js",
      "default": "./dist/reactionview-dev-tools.umd.js"
    }
  },
  "dependencies": {
    "@herb-tools/dev-tools": "https://pkg.pr.new/marcoroth/herb/@herb-tools/dev-tools@d2d24cf"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "rolldown": "^1.2.3",
    "typescript": "^7.0.2"
  },
  "files": [
    "package.json",
    "README.md",
    "dist/",
    "src/"
  ]
}
